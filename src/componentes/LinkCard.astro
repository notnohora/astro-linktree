---
import { Icon } from "astro-icon/components"
const {title, url, icon} = Astro.props
---
<a href={url} target="_blank" class="link-card">
<Icon name={icon} />
    <span class="title">
        {title}
    </span>
</a>

<style>
    .link-card {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        width: 100%;
        padding: 1rem 1.5rem;
        background-color: #302839;
        color: #fff;
        text-decoration: none;
        font-weight: 600;
        font-size: 1rem;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
        border-radius: 2rem;
        transition: transform 0.2s ease, back-ground-color 0.2 ease;
    }

    .link-card:hover {
        background-color: #5c5069;
        outline: 2px solid #7F13EC;
        outline-offset: 2px;
    }

    .title {
        text-align: center;
    }
</style>